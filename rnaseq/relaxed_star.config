// Moderate resource policy for the Diatraea relaxed-STAR run (run_paired_samples_relaxed_star).
// Pass it with: nextflow run nf-core/rnaseq -r 3.21.0 ... -c relaxed_star.config
//
// executor.cpus / executor.memory cap what this run can use in total on the shared server.
// STAR_ALIGN gets 30 threads and one task at a time; the Diatraea index is small
// (~514 Mb genome) and needs far less memory than sugarcane.

executor {
    cpus   = 64
    memory = 200.GB
}

process {
    resourceLimits = [ cpus: 30, memory: 120.GB, time: 48.h ]

    withName: '.*:ALIGN_STAR:STAR_ALIGN' {
        cpus     = 30
        memory   = 60.GB
        maxForks = 1
    }
}

// Allow -resume runs to overwrite the reports from the previous attempt
report.overwrite   = true
timeline.overwrite = true
