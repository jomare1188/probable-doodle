// Conservative resource policy for nf-core/rnaseq on the shared server.
// Pass it with: nextflow run nf-core/rnaseq ... -c star_align.config -c conservative.config
//
// The local executor schedules tasks by the cpus/memory they *request*, so
//  - executor.cpus / executor.memory cap what this run can use in total, and
//  - STAR_ALIGN requests its real peak (~147 GB RSS on the sugarcane index,
//    leaf t3_vs_t4 run) so nothing else large is scheduled alongside it.

executor {
    cpus   = 32
    memory = 200.GB
}

process {
    resourceLimits = [ cpus: 16, memory: 170.GB, time: 48.h ]

    withName: '.*:ALIGN_STAR:STAR_ALIGN' {
        cpus   = 16
        memory = 170.GB
    }
}
